# api/.htaccess — Seguridad de la carpeta API
# - Bloquear acceso directo a archivos internos (conexion, mailer, logs)
# - Bloquear scripts setup-*.php (deben restringirse a admin + SETUP_DB_KEY)
# - Permitir explicitamente el webhook publico de Stripe

<Files "conexion.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>

<Files "mailer.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</Files>

# Bloquear acceso directo a scripts de setup, migracion, logs y dumps
<FilesMatch "^(setup-.*\.php|setup_.*\.php|migrate_.*\.php|.*\.log|.*\.bak|.*\.sql|brevo_log\.txt|resend_log\.txt)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Permitir explicitamente el webhook publico de Stripe (firma verificada en PHP)
<Files "stripe-webhook.php">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
</Files>

Options -Indexes
