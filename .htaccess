# ==========================================
# .htaccess — Raiz del proyecto
# Seguridad y configuracion Apache
# ==========================================

DirectoryIndex index.html index.php

# ──────────────────────────────────────────
# FORZAR HTTPS (redirect 301 todo trafico HTTP)
# ──────────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# ──────────────────────────────────────────
# PROTEGER ARCHIVOS SENSIBLES
# ──────────────────────────────────────────
<FilesMatch "^(config\.php|env\.php|env\.example\.php|deploy_.*\.php|setup_db.*\.php|setup-.*\.php|migrate_.*\.php|update_reservas_table\.php|check\.php|check2\.php|refactor\.ps1|\.gitattributes|\.gitignore|\.env|composer\.json|composer\.lock|package\.json|package-lock\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Bloquear acceso a directorios ocultos (.git, etc.)
<IfModule mod_rewrite.c>
    RewriteRule (^|/)\.(?!well-known) - [F,L]
</IfModule>

# Bloquear acceso a documentacion, logs, backups, dumps SQL, etc.
<FilesMatch "\.(md|txt|log|bak|sql|sh|swp|tmp|orig)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# ──────────────────────────────────────────
# CABECERAS DE SEGURIDAD GLOBALES
# ──────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(self \"https://js.stripe.com\"), interest-cohort=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
</IfModule>

# ──────────────────────────────────────────
# DESACTIVAR LISTADO DE DIRECTORIOS
# ──────────────────────────────────────────
Options -Indexes -ExecCGI

# ──────────────────────────────────────────
# CACHE DE ASSETS ESTATICOS
# ──────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# ──────────────────────────────────────────
# COMPRESION GZIP
# ──────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json text/plain
</IfModule>

# ──────────────────────────────────────────
# LIMITAR TAMAÑO DE UPLOADS (10MB)
# ──────────────────────────────────────────
<IfModule mod_php.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 10M
</IfModule>
